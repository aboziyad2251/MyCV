---
import {
  certifications, competencies, contact, digitalExperience, education, highlights,
  languages, operationsExperience, person, projects, ui, type Lang, type Org, type T,
} from "../data/cv";

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = (v: T) => v[lang];
const other = lang === "en" ? "/ar/" : "/";
const otherLang = lang === "en" ? "ar" : "en";
const year = new Date().getFullYear();

const groups: { label: T; orgs: Org[] }[] = [
  { label: ui.sections.digital, orgs: digitalExperience },
  { label: ui.sections.operations, orgs: operationsExperience },
];
---
<a class="skip" href="#main">{tr(ui.skip)}</a>

<header class="topbar">
  <div class="wrap topbar__inner">
    <a class="brand" href={lang === "en" ? "/" : "/ar/"} aria-label={tr(person.name)}>
      <span class="brand__mark" aria-hidden="true">MA</span>
      <span class="brand__name">{tr(person.name)}</span>
    </a>
    <nav class="nav" aria-label="Sections">
      <a href="#profile">{tr(ui.nav.profile)}</a>
      <a href="#experience">{tr(ui.nav.experience)}</a>
      <a href="#projects">{tr(ui.nav.projects)}</a>
      <a href="#skills">{tr(ui.nav.skills)}</a>
      <a href="#contact">{tr(ui.nav.contact)}</a>
    </nav>
    <div class="topbar__actions">
      <button class="icon-btn theme-toggle" type="button" aria-label={tr(ui.theme)} title={tr(ui.theme)}>
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      </button>
      <a class="btn btn--ghost lang-switch" href={other} hreflang={otherLang} lang={otherLang} data-lang={otherLang}>{tr(ui.switchTo)}</a>
      <a class="btn btn--solid" href={contact.pdf} download>{tr(ui.downloadShort)}</a>
    </div>
  </div>
</header>

<main id="main">
  <!-- HERO -->
  <section class="hero" id="profile">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{tr(person.location)}</p>
        <h1 class="hero__name">{tr(person.name)}</h1>
        <p class="hero__headline">{tr(person.headline)}</p>
        <p class="hero__focus">{tr(person.focus)}</p>
        <p class="hero__now">{tr(person.now)}</p>
        <div class="hero__cta">
          <a class="btn btn--solid btn--lg" href="#contact">{tr(ui.talk)}</a>
          <a class="btn btn--ghost btn--lg" href={contact.pdf} download>{tr(ui.download)}</a>
        </div>
      </div>
      <dl class="kpis">
        {highlights.map((h) => (
          <div class="kpi">
            <dt class="kpi__value">{h.value}</dt>
            <dd class="kpi__label">{tr(h.label)}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="wrap">
      <div class="summary">
        <h2 class="label"><span>01</span>{tr(ui.sections.profile)}</h2>
        <p>{tr(person.summary)}</p>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="section" id="experience">
    <div class="wrap">
      <h2 class="label"><span>02</span>{tr(ui.sections.experience)}</h2>
      {groups.map((g) => (
        <div class="xp-group">
          <h3 class="xp-group__title">{tr(g.label)}</h3>
          <ol class="timeline">
            {g.orgs.map((o) => (
              <li class="org">
                <div class="org__when">{tr(o.period)}</div>
                <div class="org__body">
                  <div class="org__head">
                    <h4 class="org__name">{tr(o.org)}</h4>
                    <span class="org__place">{tr(o.place)}</span>
                  </div>
                  {o.context && <p class="org__context">{tr(o.context)}</p>}
                  {o.roles.map((r) => (
                    <div class="role">
                      <div class="role__head">
                        <h5 class="role__title">{tr(r.title)}</h5>
                        {r.period[lang] && <span class="role__period">{tr(r.period)}</span>}
                      </div>
                      {r.points.length > 0 && (
                        <ul class="role__points">
                          {r.points.map((p) => <li>{tr(p)}</li>)}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section section--alt" id="projects">
    <div class="wrap">
      <h2 class="label"><span>03</span>{tr(ui.sections.projects)}</h2>
      <div class="projects">
        {projects.map((p) => (
          <article class="project">
            <div class="project__figure">{p.figure}</div>
            <div class="project__meta"><span>{tr(p.role)}</span><span>{p.year}</span></div>
            <h3 class="project__name">{tr(p.name)}</h3>
            <p class="project__result">{tr(p.result)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SKILLS + EDUCATION -->
  <section class="section" id="skills">
    <div class="wrap">
      <h2 class="label"><span>04</span>{tr(ui.sections.skills)}</h2>
      <div class="skills">
        {competencies.map((c) => (
          <div class="skill">
            <h3 class="skill__group">{tr(c.group)}</h3>
            <ul class="chips">
              {c.items.map((i) => <li>{tr(i)}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class="creds">
        <div>
          <h2 class="label"><span>05</span>{tr(ui.sections.education)}</h2>
          <ul class="edu">
            {education.map((e) => (
              <li>
                <div class="edu__name">{tr(e.name)}</div>
                <div class="edu__row"><span>{tr(e.org)}</span><span class="mono">{tr(e.year)}</span></div>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="label"><span>06</span>{tr(ui.sections.certs)}</h2>
          {certifications.map((c) => (
            <div class="cert">
              <h3 class="cert__group">{tr(c.group)}</h3>
              <ul>
                {c.items.map((i) => <li>{tr(i)}</li>)}
              </ul>
            </div>
          ))}
          <h2 class="label label--sub"><span>07</span>{tr(ui.sections.languages)}</h2>
          <ul class="langs">
            {languages.map((l) => (
              <li><strong>{tr(l.name)}</strong><span>{tr(l.level)}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <div class="wrap contact__grid">
      <div>
        <h2 class="label label--light"><span>08</span>{tr(ui.sections.contact)}</h2>
        <p class="contact__lead">{tr(ui.contactLead)}</p>
        <div class="contact__cta">
          <a class="btn btn--solid btn--lg" href={`mailto:${contact.email}`}>{contact.email}</a>
          <a class="btn btn--ghost-light btn--lg" href={contact.pdf} download>{tr(ui.download)}</a>
        </div>
      </div>
      <ul class="channels">
        <li><span>{tr(ui.phone)}</span><a href={contact.phoneHref} dir="ltr">{contact.phone}</a></li>
        <li><span>{tr(ui.whatsapp)}</span><a href={contact.whatsapp} rel="noopener" target="_blank" dir="ltr">{contact.phone}</a></li>
        <li><span>{tr(ui.email)}</span><a href={`mailto:${contact.email}`} dir="ltr">{contact.email}</a></li>
        <li><span>{tr(ui.linkedin)}</span><a href={contact.linkedin} rel="noopener" target="_blank" dir="ltr">{contact.linkedinLabel}</a></li>
        <li><span>{tr(ui.github)}</span><a href={contact.github} rel="noopener" target="_blank" dir="ltr">github.com/aboziyad2251</a></li>
      </ul>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap footer__inner">
    <span>© {year} {tr(person.name)}. {tr(ui.rights)}</span>
    <span class="mono" dir="ltr">moh-cv.kohlestate-ksa.online</span>
  </div>
</footer>

<!-- Phone / tablet: app-style tab bar (shown by CSS on small screens only) -->
<nav class="tabbar" aria-label="Sections">
  <a href="#profile" data-sec="profile">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
    <span>{tr(ui.tabs.profile)}</span>
  </a>
  <a href="#experience" data-sec="experience">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/></svg>
    <span>{tr(ui.tabs.experience)}</span>
  </a>
  <a href="#projects" data-sec="projects">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
    <span>{tr(ui.tabs.projects)}</span>
  </a>
  <a href="#skills" data-sec="skills">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9Z"/></svg>
    <span>{tr(ui.tabs.skills)}</span>
  </a>
  <a href="#contact" data-sec="contact">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
    <span>{tr(ui.tabs.contact)}</span>
  </a>
</nav>

<script is:inline>
  // Light / dark toggle. Default follows the device setting; a manual choice is remembered.
  (function () {
    var root = document.documentElement;
    var mq = window.matchMedia("(prefers-color-scheme: dark)");
    function current() { return root.getAttribute("data-theme") || (mq.matches ? "dark" : "light"); }
    function paint() {
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", current() === "dark" ? "#0a0e1a" : "#f5f7fb");
    }
    document.querySelectorAll(".theme-toggle").forEach(function (b) {
      b.addEventListener("click", function () {
        var next = current() === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("cv-theme", next); } catch (e) {}
        paint();
      });
    });
    if (mq.addEventListener) mq.addEventListener("change", paint);
    paint();
  })();

  // Highlight the tab bar item for the section on screen.
  (function () {
    var tabs = document.querySelectorAll(".tabbar a");
    if (!("IntersectionObserver" in window) || !tabs.length) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        tabs.forEach(function (t) { t.classList.toggle("is-active", t.getAttribute("data-sec") === e.target.id); });
      });
    }, { rootMargin: "-45% 0px -50% 0px" });
    ["profile", "experience", "projects", "skills", "contact"].forEach(function (id) {
      var el = document.getElementById(id); if (el) io.observe(el);
    });
  })();

  // Register the offline cache so the site can be installed as an app.
  if ("serviceWorker" in navigator && location.protocol === "https:") {
    window.addEventListener("load", function () { navigator.serviceWorker.register("/sw.js").catch(function () {}); });
  }
</script>

<script is:inline>
  // Remember the language the visitor picks.
  document.querySelectorAll(".lang-switch").forEach(function (a) {
    a.addEventListener("click", function () {
      try { localStorage.setItem("cv-lang", a.getAttribute("data-lang")); } catch (e) {}
    });
  });
</script>
